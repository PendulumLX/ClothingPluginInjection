<Window x:Class="VamInjector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VamInjector"
        xmlns:vm="clr-namespace:VamInjector.ViewModels"
        xmlns:services="clr-namespace:VamInjector.Services"
        mc:Ignorable="d"
        Title="VAM Injector"
        Height="520" Width="780"
        MinHeight="380" MinWidth="600"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Drop zone -->
            <RowDefinition Height="*" />
            <!-- .vaj list -->
            <RowDefinition Height="Auto" />
            <!-- Error banner -->
            <RowDefinition Height="Auto" />
            <!-- Action row -->
            <RowDefinition Height="Auto" />
            <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Drop zone -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="20"
                Background="#FFF8F8F8"
                BorderBrush="#FFCCCCCC"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="VAM .var Plugin-Block Injector"
                           FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Drop a .var file here to load it."
                           Margin="0,6,0,0"
                           Foreground="#FF666666"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ArchiveDisplayName, StringFormat=Current archive: {0}}"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           FontStyle="Italic" />
            </StackPanel>
        </Border>

        <!-- .vaj entry list -->
        <Border Grid.Row="1"
                BorderBrush="#FFCCCCCC"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <ListBox x:Name="EntriesList"
                         ItemsSource="{Binding VajEntries}"
                         DisplayMemberPath="EntryName"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                <TextBlock Text="(no .vaj files)"
                           Foreground="#FF999999"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VajEntries.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="10,8"
                Background="#FFFEE8E8"
                BorderBrush="#FFE0A0A0"
                BorderThickness="1"
                CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding LastError}"
                       Foreground="#FF8B0000"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Action row -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Inject Plugin Blocks"
                    Command="{Binding InjectCommand}"
                    Padding="14,6"
                    HorizontalAlignment="Right"
                    MinWidth="180" />
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="4"
                   Margin="0,8,0,0"
                   Text="{Binding StatusMessage}"
                   Foreground="#FF666666"
                   TextWrapping="Wrap" />
    </Grid>
</Window>